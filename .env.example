# REQUIRED: create a bot with @BotFather, then send /start to it and obtain your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# REQUIRED: X developer bearer token with recent-search access.
X_BEARER_TOKEN=
X_SEARCH_QUERY=(pump.fun OR pumpfun OR memecoin OR "meme coin") lang:en -is:retweet -is:reply
X_POLL_SECONDS=180
X_MAX_RESULTS=50
X_MAX_SEARCHES_PER_HOUR=30

# REQUIRED: PumpPortal API key. New-token and migration feeds are free per PumpPortal docs;
# do not enable metered per-token/account trade subscriptions in this project.
PUMPPORTAL_API_KEY=

# Safety / signal thresholds. These are initial conservative heuristics, not proven alpha.
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_5M_USD=1500
MIN_TXNS_5M=8
MIN_PAIR_AGE_MINUTES=1
MAX_PAIR_AGE_MINUTES=240
MAX_PRICE_CHANGE_5M_PCT=90
MAX_RUGCHECK_SCORE=40
MIN_SIGNAL_SCORE=65
REQUIRE_RUGCHECK=true

# Optional overrides
DEXSCREENER_BASE_URL=https://api.dexscreener.com
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
DATABASE_PATH=data/meme_radar.sqlite3
CHECK_INTERVAL_SECONDS=20
CANDIDATE_RETRIES=6
LOG_LEVEL=INFO
